// 3. أمر الترحيب (!welcome @مستخدم)
  if (command === 'welcome') {
    if (!message.member.permissions.has(PermissionFlagsBits.ManageMessages)) return;
    const member = message.mentions.members.first() || message.member;

    // استدعاء ملف الصورة الموجود محلياً في نفس مجلد المشروع
    const { AttachmentBuilder } = require('discord.js');
    const file = new AttachmentBuilder('./welcome.png');

    const embed = new EmbedBuilder()
      .setTitle('✨ مرحباً بك في السيرفر!')
      .setDescription(`أهلاً بك يا ${member} في سيرفرنا، نتمنى لك قضاء وقت ممتع معنا! 🌹`)
      .setColor('#2b2d31')
      .setThumbnail(member.user.displayAvatarURL({ dynamic: true, size: 512 })) // صورة العضو مصغرة وأنيقة
      .setImage('attachment://welcome.png') 
      .setTimestamp();

    message.channel.send({ content: `${member}`, embeds: [embed], files: [file] });
  }
